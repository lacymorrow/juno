# GitHub OAuth app credentials
# Create at https://github.com/settings/applications/new
# Authorization callback URL: https://your-fly-app.fly.dev/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Public URL of this server (used for OAuth callback)
BASE_URL=https://juno-remote-control.fly.dev

# Random secret for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change_me_in_production

# JSON map of device_id -> api_key for Juno device auth
# Each Juno device connects with its device_id and signs requests with this key
DEVICE_API_KEYS={"your-device-uuid": "your-device-api-key"}

# Directory for SQLite session store (Fly.io: use the /data mount)
DATA_DIR=.
