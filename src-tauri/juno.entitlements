<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JIT for the WKWebView-hosted frontend under hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Apple Events: required for AppleScript-driven automation (media control, app scripting) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Library validation stays disabled: whisper/Metal dylibs from the
         voice-transcription plugin are not signed with our Team ID -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Hardened-runtime microphone access for native voice recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Hardened-runtime camera access -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- 2026-09 security audit cleanup. Removed:
         - cs.allow-unsigned-executable-memory and cs.allow-dyld-environment-variables
           (code-injection vectors; not needed for accessibility APIs)
         - device.microphone, personal-information.location, network.client,
           files.user-selected.read-write, files.downloads.read-write
           (App Sandbox-only keys; inert without com.apple.security.app-sandbox)
         - input-monitoring (not a real entitlement; Input Monitoring is TCC-only)
         - system-extension (wrong key name; we ship no system extension)
         - automation.scripting-targets (takes a dict of targets, not <true/>) -->
</dict>
</plist>
