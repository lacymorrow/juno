{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juno",
  "identifier": "com.juno.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Juno",
        "width": 600,
        "height": 700,
        "minWidth": 380,
        "minHeight": 500,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": true
      },
      {
        "label": "floating-panel",
        "url": "/floating-panel",
        "width": 180,
        "height": 100,
        "minWidth": 120,
        "minHeight": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "center": false
      },
      {
        "label": "floating-bar",
        "url": "/floating-bar",
        "width": 419,
        "height": 92,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "onboarding",
        "title": "Welcome to Juno",
        "url": "/onboarding",
        "width": 440,
        "height": 700,
        "minWidth": 200,
        "minHeight": 300,
        "hiddenTitle": false,
        "resizable": false,
        "visible": true,
        "skipTaskbar": false,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": false
      },
      {
        "label": "desktop-cursor-overlay",
        "url": "/desktop-cursor-overlay",
        "width": 1,
        "height": 1,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "center": false,
        "fullscreen": false
      },
      {
        "label": "settings",
        "title": "Juno Settings",
        "url": "/settings",
        "width": 700,
        "height": 600,
        "minWidth": 420,
        "minHeight": 300,
        "hiddenTitle": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://storage.googleapis.com; font-src 'self' data:; connect-src 'self' wss://juno-cloud-backend.fly.dev https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.elevenlabs.io https://api.replicate.com https://storage.googleapis.com https://ejiidnob33g9ap1r.public.blob.vercel-storage.com; media-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NkUzQjdGQTA3NEFDODUKUldTRnJIU2dmenR1aGZxejRsZy9FRlljTmRHcitQZTFIQUdObnIzeDZGemI0YTQyQTM1NGFzY3YK",
      "endpoints": [
        "https://github.com/lacymorrow/juno/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../tauri-plugin-voice-transcription/models/*",
      "Info.plist",
      "../public/sounds/**/*"
    ],
    "macOS": {
      "entitlements": "juno.entitlements",
      "files": {
        "Info.plist": "Info.plist"
      }
    }
  }
}
