{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juno",
  "identifier": "com.juno.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Juno",
        "width": 600,
        "height": 700,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": true
      },
      {
        "label": "floating-panel",
        "url": "/floating-panel",
        "width": 180,
        "height": 100,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "center": false
      },
      {
        "label": "floating-bar",
        "url": "/floating-bar",
        "width": 110,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      },
      {
        "label": "onboarding",
        "title": "Welcome to Juno",
        "url": "/onboarding",
        "width": 440,
        "height": 700,
        "minWidth": 200,
        "minHeight": 300,
        "hiddenTitle": false,
        "resizable": false,
        "visible": true,
        "skipTaskbar": false,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": false
      },
      {
        "label": "desktop-cursor-overlay",
        "url": "/desktop-cursor-overlay",
        "width": 1,
        "height": 1,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "center": false,
        "fullscreen": false
      },
      {
        "label": "settings",
        "title": "Juno Settings",
        "url": "/settings",
        "width": 700,
        "height": 600,
        "minWidth": 420,
        "minHeight": 300,
        "hiddenTitle": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../tauri-plugin-voice-transcription/models/*",
      "Info.plist",
      "../public/sounds/**/*",
      "../.env"
    ],
    "macOS": {
      "entitlements": "juno.entitlements",
      "files": {
        "Info.plist": "Info.plist"
      }
    }
  }
}
