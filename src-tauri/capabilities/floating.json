{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating",
  "description": "Capability for the floating bar",
  "windows": ["floating-bar"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "opener:default",
    "notification:default"
  ]
}
