{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating",
  "description": "Capability for the floating bar and panel",
  "windows": [
    "floating-bar",
    "floating-panel",
    "app-bar",
    "dynamic-bar",
    "voice-ai-bar",
    "voice-bar"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "notification:default",
    "voice-transcription:default",
    "voice-transcription:allow-toggle-dictation",
    "voice-transcription:allow-start-dictation",
    "voice-transcription:allow-stop-dictation",
    "voice-transcription:allow-get-dictation-status",
    "voice-transcription:allow-transcribe-file",
    "voice-transcription:allow-set-model-path",
    "voice-transcription:allow-get-model-path"
  ]
}
