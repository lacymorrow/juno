**/debug/*
**/release/*

# Tauri WiX toolset cache (Windows)
*.wixobj
*.wixpdb

# macOS specific Tauri files
*.dmg
*.app

# Windows specific Tauri files
*.msi
*.exe

# Linux specific Tauri files
*.AppImage
*.deb
*.rpm

