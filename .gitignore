# =============================================================================
# Juno AI - Comprehensive .gitignore
# Tauri + Vite + TypeScript + Rust + Bun project
# =============================================================================

# Audio files (project-specific)
debug_live_audio.wav
*.wav
*.aiff
*.m4a
*.mp3
*.ogg

# =============================================================================
# Node.js / JavaScript / TypeScript
# =============================================================================

# Dependencies
node_modules/
jspm_packages/

# Build outputs
dist/
dist-ssr/
build/
out/

# Vite
.vite/
vite.config.*.timestamp-*

# TypeScript
*.tsbuildinfo
.tscache/

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.cache/
.parcel-cache/

# Next.js build output
.next/

# Nuxt.js build / generate output
.nuxt/

# Gatsby files
.cache/
# public/ - Commented out as this is a Tauri app that needs public assets tracked

# Storybook build outputs
.out/
.storybook-out/

# Temporary folders
tmp/
temp/

# =============================================================================
# Package Managers
# =============================================================================

# Bun (keep bun.lock - it should be committed)
# bun.lock should NOT be ignored for main project

# Yarn (not used but common)
yarn.lock
.yarn/
.pnp.*

# PNPM (not used but common)
pnpm-lock.yaml

# NPM (not used but common)
package-lock.json

# =============================================================================
# Rust / Cargo
# =============================================================================

# Rust build artifacts
target/
**/target/
Cargo.lock

# Rust procedural macros
*.pdb

# Rustfmt backup files
*.rs.bak

# Clippy cache
.clippy/

