#[command]
pub async fn check_permissions(app: AppHandle) -> Result<PermissionStatus, String> {
    let mut status = PermissionStatus::default();

    // Check accessibility permissions
    status.accessibility = check_accessibility_permission().await?;

    // Check microphone permissions
    status.microphone = check_microphone_permission().await?;

    Ok(status)
