## Frontend Integration Guidelines

### TypeScript Integration Pattern
```typescript
// State management
const [isAlwaysListening, setIsAlwaysListening] = useState(false);
const [alwaysListeningSensitivity, setAlwaysListeningSensitivity] = useState(0.5);
const [alwaysListeningWakeWords, setAlwaysListeningWakeWords] = useState<string[]>([]);

// Event listeners
useEffect(() => {
    const unlistenStart = await listen("always_listening_started", () => {
        setIsAlwaysListening(true);
    });

    const unlistenStop = await listen("always_listening_stopped", () => {
        setIsAlwaysListening(false);
    });

    const unlistenWakeWord = await listen("always_listening_wake_word_detected", () => {
        // Automatically transition to Agent Mode
        setBarState("listening");
    });

    return () => {
        unlistenStart();
        unlistenStop();
        unlistenWakeWord();
    };
}, []);

// Command invocation
const toggleAlwaysListening = async () => {
    try {
        await invoke("toggle_always_listening_mode");
    } catch (error) {
        console.error("Failed to toggle always listening:", error);
    }
};
```

