  } catch (error) {
    console.error(`UI interaction failed:`, error);
  }
};
```

## CRITICAL RULES - What Actually Works

### ✅ **DO: Use Real Backend Integration**

```typescript
// Listen to actual events the backend emits
const unlisten = listen("bar-state-update", handleStateUpdate);

// Call actual commands that exist in the backend
await invoke("ui_handle_interaction", {
  elementId: "your-element-id",
  interaction: { interaction_type: "click", data: {} }
});
```

### ❌ **DON'T: Use Non-Existent APIs**

```typescript
// ❌ WRONG - These commands don't exist
await invoke("ui_get_state", { elementId: "foo" });
await invoke("ui_set_state", { elementId: "foo", state: {} });

// ❌ WRONG - These types were deleted
import { BarState, FloatingBarConfig } from "@/types/floating-bar";

// ❌ WRONG - These functions were removed
convertUIStateToBarState(state);
convertBarStateToUIState(state);
```

### ✅ **DO: Define Types Inline**

```typescript
// Define component-specific types directly in the component
type UIState =
  | "default" | "expanding" | "input" | "shrinking"
  | "submitting" | "loading" | "finishing" | "success"
  | "listening" | "error" | "transcribing" | "speaking"
  | "dictating" | "always-listening";

interface UIStateData {
  uiState: UIState;
  inputValue: string;
  isVisible: boolean;
  config: UIElementConfig;
  // ... other properties as needed
}
```

### ✅ **DO: Handle Backend Events Properly**

```typescript
// Proper event handling pattern
useEffect(() => {
  const unlisten = listen("bar-state-update", (event) => {
    const stateData = event.payload as UIStateData;

    // Update local state directly
    setState(stateData.uiState);
    setInputValue(stateData.inputValue);
    setIsVisible(stateData.isVisible);

    // Handle config updates
    if (stateData.config) {
      setConfig(stateData.config);
    }
  });

  return () => {
    unlisten.then(fn => fn());
  };
}, []);
```

